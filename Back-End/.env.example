# Copy to .env and configure local-only values. Never commit .env.
NODE_ENV=development
PORT=3000
DB_CONNECTION_STRING=
JWT_SECRET=
DEV_BYPASS_AUTH=true
CORS_ORIGIN=http://localhost:5173

# Local Docker Compose licenses and credentials. Review the licenses before ACCEPT_EULA=Y.
ACCEPT_EULA=
MSSQL_SA_PASSWORD=
SQLCMD_DATABASE=FileValidationPlatform

# Local Service Bus emulator connection string must be set in .env only.
SERVICEBUS_CONNECTION_STRING=
SERVICEBUS_NAMESPACE=
SERVICEBUS_VALIDATION_QUEUE=validation-requests
SERVICEBUS_EVENTS_TOPIC=validation-events
SERVICEBUS_EVENTS_SUBSCRIPTION=api
SERVICEBUS_DELIVERY_QUEUE=delivery-requests
SERVICEBUS_DELIVERY_RETRY_BASE_MS=5000
SERVICEBUS_EMULATOR_HTTP_PORT=5300
SQL_WAIT_INTERVAL=15
WORKER_MODE=local
WORKER_MAX_MESSAGES=1

# Uploads always use Blob Storage. Keep the local Azurite connection string in .env only.
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_UPLOADS_CONTAINER=uploads
AZURE_STORAGE_REPORTS_CONTAINER=reports
AZURE_STORAGE_STAGING_CONTAINER=staging
AZURE_STORAGE_DELIVERIES_CONTAINER=deliveries
AZURE_STORAGE_TEMPLATES_CONTAINER=templates
RULES_SERVICE_URL=http://localhost:8000
RULES_SERVICE_DEV_KEY=
RULES_SERVICE_TIMEOUT_MS=30000
RULES_SERVICE_HOST=0.0.0.0
RULES_SERVICE_PORT=8000

# Local delivery target and template files; uploads themselves are stored in Blob.
SHAREPOINT_LOCAL_PATH=./sharepoint
TEMPLATE_STORAGE_PATH=./uploads/templates
DELIVERY_ROOT_PATH=./deliveries
DELIVERY_PROVIDER=local
UPLOAD_MAX_FILE_SIZE=100
LOG_LEVEL=info

# Natural-language rule authoring uses the configured Microsoft Foundry project.
# DefaultAzureCredential uses your local Azure CLI identity; do not put API keys here.
AZURE_FOUNDRY_RESOURCE=
AZURE_FOUNDRY_PROJECT=
AZURE_FOUNDRY_MODEL=
# Opt in to logging full model output; it may include submitted rule text and schema details.
NATURAL_LANGUAGE_RULE_DEBUG=false

# Optional local Entra SSO configuration.
MS_SSO_ENABLED=false
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_REDIRECT_URI=http://localhost:5173/auth/callback

# Optional monitoring and API rate-limit configuration.
METRICS_TOKEN=
RATE_LIMIT_MAX=1000
RATE_LIMIT_WINDOW_MS=900000
APPLICATIONINSIGHTS_CONNECTION_STRING=

# In Azure, use the storage account URL and managed identity instead of a connection string.
AZURE_STORAGE_ACCOUNT_URL=
