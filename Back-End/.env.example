# Copy to .env and configure local-only values. Never commit .env.
# This one file is shared by start.ps1, the Node API, the Python rules service/worker and Docker Compose.
NODE_ENV=development
PORT=3000
# Direct local access trusts no proxies. Direct Azure Container Apps ingress uses 1.
TRUST_PROXY_HOPS=0
# Local Docker SQL Server connection string (start.ps1 requires localhost:1433 and the SQLCMD_DATABASE database).
# In Azure the API and worker use DB_SERVER + DB_DATABASE with managed identity instead of a connection string.
DB_CONNECTION_STRING=
# DB_SERVER=
# DB_DATABASE=
# Required: a long random value used to sign app JWTs.
JWT_SECRET=
# Local demo login only. Honoured only when NODE_ENV=development; set to false (or remove) for anything else.
DEV_BYPASS_AUTH=true
CORS_ORIGIN=http://localhost:5173

# Local Docker Compose licenses and credentials. Review the licenses before ACCEPT_EULA=Y.
ACCEPT_EULA=
MSSQL_SA_PASSWORD=
SQLCMD_DATABASE=FileValidationPlatform

# Local Service Bus emulator connection string must be set in .env only.
SERVICEBUS_CONNECTION_STRING=
SERVICEBUS_NAMESPACE=
SERVICEBUS_VALIDATION_QUEUE=validation-requests
SERVICEBUS_EVENTS_TOPIC=validation-events
SERVICEBUS_EVENTS_SUBSCRIPTION=api
SERVICEBUS_DELIVERY_QUEUE=delivery-requests
SERVICEBUS_DELIVERY_RETRY_BASE_MS=5000
# Messages the API handles in parallel for each consumer.
VALIDATION_WORKER_CONCURRENCY=5
DELIVERY_WORKER_CONCURRENCY=5
SERVICEBUS_EMULATOR_HTTP_PORT=5300
SQL_WAIT_INTERVAL=15

# Uploads always use Blob Storage. Keep the local Azurite connection string in .env only.
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_UPLOADS_CONTAINER=uploads
AZURE_STORAGE_REPORTS_CONTAINER=reports
AZURE_STORAGE_STAGING_CONTAINER=staging
AZURE_STORAGE_DELIVERIES_CONTAINER=deliveries
AZURE_STORAGE_TEMPLATES_CONTAINER=templates

# Rules service. Locally the API and service share RULES_SERVICE_DEV_KEY (shared-key mode).
# In Azure the API sends an Entra token for RULES_SERVICE_AAD_SCOPE and the service runs in entra mode (set by the deployment).
RULES_SERVICE_URL=http://localhost:8000
RULES_SERVICE_DEV_KEY=
RULES_SERVICE_AUTH_MODE=shared-key
# RULES_SERVICE_AAD_SCOPE=
RULES_SERVICE_TIMEOUT_MS=30000
RULES_SERVICE_HOST=0.0.0.0
RULES_SERVICE_PORT=8000

# Local delivery target and template files; uploads themselves are stored in Blob.
# DELIVERY_PROVIDER=azure writes to the Blob deliveries container instead (used in Azure).
TEMPLATE_STORAGE_PATH=./uploads/templates
DELIVERY_ROOT_PATH=./deliveries
DELIVERY_PROVIDER=local
# Largest accepted upload, in MB.
UPLOAD_MAX_FILE_SIZE=100
UPLOAD_TEMP_DIR=./temp
# Seconds to cache dashboard statistics.
STATS_CACHE_TTL=300
LOG_LEVEL=info

# Natural-language rule authoring uses your Citadel APIM Responses API; CITADEL_ENDPOINT has no default and is required.
# Set the subscription key only in your ignored .env; Azure uses a Key Vault reference.
CITADEL_ENDPOINT=
CITADEL_SUBSCRIPTION_KEY=
CITADEL_SUBSCRIPTION_KEY_HEADER=api-key
# A deployment name exposed by your gateway; the example value is only a placeholder.
CITADEL_MODEL=gpt-6-luna
# Opt in to logging full model output; it may include submitted rule text and schema details.
NATURAL_LANGUAGE_RULE_DEBUG=false

# Optional local Entra SSO configuration (single-tenant Web app registration).
MS_SSO_ENABLED=false
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_REDIRECT_URI=http://localhost:5173/auth/callback
# Defaults to https://login.microsoftonline.com; override only for a sovereign cloud.
# MS_AUTHORITY=

# Optional monitoring and API rate-limit configuration. /metrics requires this token as a Bearer token when set; without it, only development serves metrics.
METRICS_TOKEN=
RATE_LIMIT_MAX=1000
RATE_LIMIT_WINDOW_MS=900000
APPLICATIONINSIGHTS_CONNECTION_STRING=
# The API defaults to data-ingestion-api; set OTEL_SERVICE_NAME only per process.
# 1 captures all traces; lower this ratio to reduce production ingestion.
APPLICATIONINSIGHTS_SAMPLING_RATIO=1

# In Azure, use the storage account URL and managed identity instead of a connection string.
AZURE_STORAGE_ACCOUNT_URL=
