# Copy to .env in Back-End. Do not commit the resulting file.
NODE_ENV=development
PORT=3000

# Set this to your local SQL Server database. Use a local-only login; do not commit credentials.
# Windows LocalDB: Server=(localdb)\MSSQLLocalDB;Database=FileValidationPlatform;Integrated Security=true
# LocalDB requires the optional msnodesqlv8 package and ODBC Driver 17 for SQL Server.
# Example format: Server=127.0.0.1,1433;Database=FileValidationPlatform;User ID=<user>;Password=<password>;Encrypt=True;TrustServerCertificate=True
DB_CONNECTION_STRING=
JWT_SECRET=
DEV_BYPASS_AUTH=true
CORS_ORIGIN=http://localhost:5173

# Redis is optional for local development. Enabling it requires a running Redis server.
REDIS_ENABLED=false
REDIS_HOST=localhost
REDIS_PORT=6379

# The sharepoint provider stores files locally; no Azure credentials are needed.
STORAGE_PROVIDER=sharepoint
SHAREPOINT_LOCAL_PATH=./sharepoint
UPLOAD_TEMP_DIR=./temp
UPLOAD_MAX_FILE_SIZE=100
LOG_LEVEL=info

# Natural-language rule authoring (admin only). The model deployment must exist in this Foundry project.
# DefaultAzureCredential uses your Azure CLI identity locally or managed identity in Azure.
# Grant the backend identity access to invoke the model in the project; no API key is stored here.
AZURE_FOUNDRY_RESOURCE=aif-zlyway6g7icoy-0
AZURE_FOUNDRY_PROJECT=citadel-governance-project
AZURE_FOUNDRY_MODEL=gpt-5.6-luna
# Optional: choose the local sign-in DefaultAzureCredential uses (for example when the Azure CLI is signed in to another tenant).
# AZURE_TOKEN_CREDENTIALS=AzureDeveloperCliCredential
# Sandbox limits for the generated code of each Natural Language rule, per upload.
# RULE_SANDBOX_TIME_LIMIT_MS=20000
# RULE_SANDBOX_MEMORY_LIMIT_MB=64

# Admin-uploaded definition templates (local providers). Azure uses the templates container below.
TEMPLATE_STORAGE_PATH=./uploads/templates
# Optional file-copy delivery. A definition's delivery folder is resolved under this root;
# definitions without a delivery folder finish as VALIDATED.
DELIVERY_ROOT_PATH=./deliveries

# Protect /metrics outside development with a bearer token (Authorization: Bearer <token>).
# METRICS_TOKEN=
# API rate limit per client IP (defaults: 1000 requests per 15 minutes).
# RATE_LIMIT_MAX=1000
# RATE_LIMIT_WINDOW_MS=900000

# Optional Microsoft Entra ID SSO (confidential web app, authorization code + PKCE).
# Register the redirect URI below in the app registration. Keep the client secret out of source control.
MS_SSO_ENABLED=false
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_REDIRECT_URI=http://localhost:5173/auth/callback

# For Azure Blob Storage only, set STORAGE_PROVIDER=azure and configure:
# AZURE_STORAGE_CONNECTION_STRING=
# AZURE_STORAGE_CONTAINER=uploads
# AZURE_STORAGE_COMPRESSED_CONTAINER=compressed
# AZURE_STORAGE_TEMPLATES_CONTAINER=templates
# Templates can use Microsoft Entra ID (managed identity / az login) instead of a connection string:
# AZURE_STORAGE_ACCOUNT_URL=https://<account>.blob.core.windows.net
