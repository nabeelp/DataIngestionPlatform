# Only needed when running the Python service outside start.ps1 (which loads Back-End/.env instead).
# Keep real credentials and emulator connection strings in .env only; never commit .env.
DB_CONNECTION_STRING=
# In Azure the service uses DB_SERVER + DB_DATABASE with managed identity instead of a connection string.
# DB_SERVER=
# DB_DATABASE=

AZURE_STORAGE_CONNECTION_STRING=
# In Azure, use the storage account URL and managed identity instead of a connection string.
# AZURE_STORAGE_ACCOUNT_URL=
# Pin the Blob REST API version (the Azurite emulator can lag the SDK default).
# AZURE_STORAGE_API_VERSION=
AZURE_STORAGE_UPLOADS_CONTAINER=uploads
AZURE_STORAGE_REPORTS_CONTAINER=reports
AZURE_STORAGE_STAGING_CONTAINER=staging

SERVICEBUS_CONNECTION_STRING=
# SERVICEBUS_NAMESPACE=
SERVICEBUS_VALIDATION_QUEUE=validation-requests
SERVICEBUS_EVENTS_TOPIC=validation-events

# Rules API: shared-key locally (RULES_SERVICE_DEV_KEY must match the API); entra in Azure.
RULES_SERVICE_AUTH_MODE=shared-key
RULES_SERVICE_DEV_KEY=
# Entra mode only: object ID of the API managed identity allowed to call the service.
# RULES_SERVICE_API_PRINCIPAL_ID=
RULES_SERVICE_HOST=0.0.0.0
RULES_SERVICE_PORT=8000

# Worker: local mode processes WORKER_MAX_MESSAGES then exits.
WORKER_MODE=local
WORKER_MAX_MESSAGES=1

LOG_LEVEL=info
# Optional telemetry; the worker and API default to their own service names.
APPLICATIONINSIGHTS_CONNECTION_STRING=
APPLICATIONINSIGHTS_SAMPLING_RATIO=1
# OTEL_SERVICE_NAME=
