# Local development: leave VITE_API_URL and VITE_WS_URL unset to use Vite's
# same-origin /api and /socket.io proxies to http://localhost:3000.
# Set these only if the backend is hosted elsewhere or no proxy is available.
# VITE_API_URL=https://your-api-domain.example/api/v1
# VITE_WS_URL=https://your-api-domain.example

# Optional local demo login (admin@company.com / user@company.com).
# Explicitly set to true only in Vite development mode; never use for production.
VITE_DEV_BYPASS_AUTH=false
