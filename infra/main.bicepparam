using './main.bicep'

param workloadName = readEnvironmentVariable('WORKLOAD_NAME', 'dataingest')
param environmentName = readEnvironmentVariable('AZURE_ENV_NAME', 'dev')
param location = readEnvironmentVariable('AZURE_LOCATION', 'eastus2')
param tenantId = readEnvironmentVariable('AZURE_TENANT_ID', '00000000-0000-0000-0000-000000000000')
param sqlAdminObjectId = readEnvironmentVariable('SQL_ADMIN_OBJECT_ID', '00000000-0000-0000-0000-000000000000')
param sqlAdminLogin = readEnvironmentVariable('SQL_ADMIN_LOGIN', 'deployment-admin')
param sqlBootstrapPassword = readEnvironmentVariable('SQL_BOOTSTRAP_PASSWORD', '')
param rulesServiceApiClientId = readEnvironmentVariable('RULES_SERVICE_API_CLIENT_ID', '00000000-0000-0000-0000-000000000000')
param rulesServiceApiAudience = readEnvironmentVariable('RULES_SERVICE_API_AUDIENCE', 'api://00000000-0000-0000-0000-000000000000')
param ssoClientId = readEnvironmentVariable('MS_CLIENT_ID', '00000000-0000-0000-0000-000000000000')
param foundryProjectResourceId = readEnvironmentVariable('FOUNDRY_PROJECT_RESOURCE_ID', '')
param foundryResourceName = readEnvironmentVariable('AZURE_FOUNDRY_RESOURCE', 'aif-zlyway6g7icoy-0')
param foundryProjectName = readEnvironmentVariable('AZURE_FOUNDRY_PROJECT', 'citadel-governance-project')
param imageTag = readEnvironmentVariable('IMAGE_TAG', 'bootstrap')
param workerCpu = int(readEnvironmentVariable('WORKER_CPU', '2'))
param workerMemory = readEnvironmentVariable('WORKER_MEMORY', '4Gi')
param jwtSecret = readEnvironmentVariable('JWT_SECRET', '')
param msClientSecret = readEnvironmentVariable('MS_CLIENT_SECRET', '')
