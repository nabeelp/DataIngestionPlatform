    {
      "id": "xsheet-fk-orders-customers",
      "category": "cross-sheet",
      "definition": "sales",
      "request": "Every order that has a customer id must use one that exists in the Customers sheet; orders with a blank customer id are ignored.",
      "expected": { "decision": "natural_language", "type": "naturalLanguage", "mode": "query" },
      "referenceProposal": {
        "decision": "natural_language", "reason": "Referential integrity across two sheets needs a join.", "name": "Order customer exists", "severity": "Error",
        "table": null, "type": "naturalLanguage",
        "params": {
          "mode": "query", "failWhen": null,
          "query": "SELECT o.__row AS __row, 'Orders' AS \"table\", 'CustomerId' AS \"column\", 'Order references an unknown customer.' AS message FROM t_1 AS o LEFT JOIN t_0 AS c ON o.CustomerId = c.Id WHERE o.CustomerId IS NOT NULL AND c.Id IS NULL",
          "tableColumns": [{ "table": "Customers", "columns": ["Id"] }, { "table": "Orders", "columns": ["CustomerId"] }],
          "explanation": "Orders whose customer id is not found in Customers are reported.", "message": "Order references an unknown customer."
        },
        "examples": [
          { "table": "Orders", "values": [{ "column": "CustomerId", "value": "C1" }], "expectedValid": true, "relatedRows": [{ "table": "Customers", "values": [{ "column": "Id", "value": "C1" }] }] },
          { "table": "Orders", "values": [{ "column": "CustomerId", "value": "C9" }], "expectedValid": false, "relatedRows": [{ "table": "Customers", "values": [{ "column": "Id", "value": "C1" }] }] },
          { "table": "Orders", "values": [{ "column": "CustomerId", "value": null }], "expectedValid": true, "relatedRows": [] }
        ]
      },
      "data": {
        "violating": {
          "Customers": [
            { "Id": "C1", "Name": "Ann", "Country": "US", "Email": "ann@x.com" },
            { "Id": "C2", "Name": "Bob", "Country": "FR", "Email": "bob@x.com" }
          ],
          "Orders": [
            { "OrderId": "O1", "CustomerId": "C1", "OrderDate": "2025-01-10", "Amount": "10", "Status": "Open" },
            { "OrderId": "O2", "CustomerId": "C9", "OrderDate": "2025-01-11", "Amount": "20", "Status": "Open" },
            { "OrderId": "O3", "CustomerId": null, "OrderDate": "2025-01-12", "Amount": "30", "Status": "Open" }
          ]
        },
        "clean": {
          "Customers": [{ "Id": "C1", "Name": "Ann", "Country": "US", "Email": "ann@x.com" }],
          "Orders": [{ "OrderId": "O1", "CustomerId": "C1", "OrderDate": "2025-01-10", "Amount": "10", "Status": "Open" }]
        }
      },
      "expectedFailures": [{ "sheet": "Orders", "row": 3 }]
    },
