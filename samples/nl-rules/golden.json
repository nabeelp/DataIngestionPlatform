{
  "description": "Golden prompts for natural-language rule generation. Each case carries a reference proposal in the model's output format, sample data that must (violating) or must not (clean) trigger the rule, and the expected failing rows. Used by Validation-Service/tests/rules/test_golden_corpus.py, Back-End/tests/NaturalLanguageGolden.test.ts and Back-End/scripts/eval-nl-rules.ts. Rows are physical rows (header on row 1).",
  "definitions": {
    "sales": {
      "layout": "sheets",
      "tables": [
        { "sheet": "Customers", "columns": [["Id", "string"], ["Name", "string"], ["Country", "string"], ["Email", "string"]] },
        { "sheet": "Orders", "columns": [["OrderId", "string"], ["CustomerId", "string"], ["OrderDate", "date"], ["Amount", "decimal"], ["Status", "string"]] },
        { "sheet": "Payments", "columns": [["PaymentId", "string"], ["OrderId", "string"], ["PaidDate", "date"], ["Amount", "decimal"]] }
      ]
    },
    "contacts": {
      "layout": "single",
      "tables": [
        { "sheet": null, "columns": [["Email", "string"], ["Phone", "string"], ["Age", "integer"], ["Country", "string"], ["Status", "string"]] }
      ]
    }
  },
  "cases": [
    {
      "id": "builtin-enum",
      "category": "builtin",
      "definition": "sales",
      "request": "Order status must be one of Open, Paid or Cancelled.",
      "expected": { "decision": "mapped", "type": "enum" },
      "referenceProposal": {
        "decision": "mapped", "reason": "An allowed-values check is the enum type.", "name": "Valid order status", "severity": "Error",
        "table": "Orders", "type": "enum",
        "params": { "column": "Status", "values": ["Open", "Paid", "Cancelled"], "caseSensitive": true, "trim": true },
        "examples": []
      },
      "data": {
        "violating": { "Orders": [
          { "OrderId": "O1", "CustomerId": "C1", "OrderDate": "2025-01-10", "Amount": "10", "Status": "Open" },
          { "OrderId": "O2", "CustomerId": "C1", "OrderDate": "2025-01-11", "Amount": "20", "Status": "Lost" }
        ] },
        "clean": { "Orders": [
          { "OrderId": "O1", "CustomerId": "C1", "OrderDate": "2025-01-10", "Amount": "10", "Status": "Open" },
          { "OrderId": "O2", "CustomerId": "C1", "OrderDate": "2025-01-11", "Amount": "20", "Status": "Paid" }
        ] }
      },
      "expectedFailures": [{ "sheet": "Orders", "row": 3 }]
    },
