{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://dataintegrationplatform.local/contracts/messages/delivery-request.schema.json",
  "title": "DeliveryRequest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "uploadId", "attempt"],
