{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://dataintegrationplatform.local/contracts/messages/validation-event.schema.json",
  "title": "ValidationEvent",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "uploadId", "type", "stage", "percent"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "uploadId": { "type": "string", "minLength": 1 },
    "type": { "enum": ["progress", "completed", "failed"] },
    "stage": { "enum": ["download", "sniff", "parse", "rules", "persist"] },
    "percent": { "type": "integer", "minimum": 0, "maximum": 100 },
    "summary": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "passed", "failed", "warnings", "rowCount"],
      "properties": {
        "status": { "enum": ["PASSED", "WARNING", "FAILED"] },
        "passed": { "type": "integer", "minimum": 0 },
        "failed": { "type": "integer", "minimum": 0 },
        "warnings": { "type": "integer", "minimum": 0 },
        "rowCount": { "type": "integer", "minimum": 0 }
      }
    },
    "error": { "type": "string" }
  }
}
