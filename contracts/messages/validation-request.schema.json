{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://dataintegrationplatform.local/contracts/messages/validation-request.schema.json",
  "title": "ValidationRequest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "uploadId", "definitionVersionId", "blob", "fileType", "requestedAt", "correlationId"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "uploadId": { "type": "string", "minLength": 1 },
    "definitionVersionId": { "type": "string", "minLength": 1 },
    "blob": {
      "type": "object", "additionalProperties": false, "required": ["container", "name"],
      "properties": { "container": { "type": "string" }, "name": { "type": "string" } }
    },
    "fileType": { "enum": ["csv", "tsv", "txt", "xlsx", "xlsm", "xls", "xlsb"] },
    "requestedAt": { "type": "string", "format": "date-time" },
    "correlationId": { "type": "string", "minLength": 1 }
  }
}
